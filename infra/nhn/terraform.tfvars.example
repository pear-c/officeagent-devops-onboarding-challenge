# NHN root module — 변수 placeholder
#
# 실 자격증명은 이 파일을 `terraform.tfvars`로 복사 후 채워서 사용.
# `terraform.tfvars`는 gitignore 대상 — 절대 커밋 금지.
#
# 본 PoC는 실 apply 없으므로 placeholder만으로도 validate / plan(-refresh=false) PASS.

# ─── Provider 인증 (실 운영 시 환경변수 OS_USERNAME / OS_PASSWORD / OS_PROJECT_ID 대체 가능) ───

region    = "KR1"                                                   # 판교
auth_url  = "https://api-identity-infrastructure.nhncloudservice.com/v2.0"
user_name = "<replace-with-nhn-user-email-or-iam-username>"
password  = "<replace-with-password-or-app-credential>"
tenant_id = "<replace-with-project-uuid>"

# ─── 네트워크 ─────────────────────────────────────────────────────────────────

service_name = "officeagent"
environment  = "prod"
vpc_cidr     = "10.0.0.0/16"

zone_cidrs = {
  public      = "10.0.10.0/24"
  private_app = "10.0.20.0/24"
  private_db  = "10.0.30.0/24"
  external    = "10.0.40.0/24"
  management  = "10.0.100.0/24"
}

common_tags = {
  project    = "officeagent"
  managed_by = "terraform"
  csap_tier  = "medium"
  owner      = "<team-or-owner-id>"
}
